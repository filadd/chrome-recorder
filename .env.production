# Prod build config — loaded by `npm run build`.

# The Filadd production gateway origin. The extension uploads through
# `/api/chrome-recorder/uploads…`; the gateway validates the JWT, injects
# `X-UserId`, and proxies to chrome-recorder-consumer-api.
VITE_API_BASE_URL=https://gateway.filadd.com

# The Filadd auth service origin. The extension logs in (email code) and refreshes
# its own token directly against this origin, not the gateway.
VITE_AUTH_BASE_URL=https://auth.filadd.com

# Allowlisted continue_url the login endpoints require (not redirected to — the tokens
# come back in the response body).
VITE_AUTH_CONTINUE_URL=https://filadd.com
