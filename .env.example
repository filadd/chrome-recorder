# Extension build-time config (Vite injects VITE_-prefixed vars at build).
#
# Per-mode files are committed and selected by the build command:
#   .env.development  → `npm run dev` (HMR) and `npm run build:dev`
#   .env.production   → `npm run build`
# For a personal override without touching the committed files, add a gitignored
# `.env.development.local` / `.env.production.local` (or `.env.local`, all modes).

# Filadd gateway origin the extension uploads through. The upload path prefix
# (`/api/chrome-recorder`) is baked into the client; this is just the origin.
# Local: the local gateway (http://gateway-service.docker, the dockerfiles VIRTUAL_HOST).
# Prod: https://gateway.filadd.com.
VITE_API_BASE_URL=http://gateway-service.docker

# Filadd auth service origin. The extension logs in with an email code and refreshes
# its own token directly here (not through the gateway).
# Local: http://auth-service.docker. Prod: https://auth.filadd.com.
VITE_AUTH_BASE_URL=http://auth-service.docker

# Allowlisted continue_url the login endpoints require. Not redirected to — the tokens
# come back in the response body — so any allowlisted host works.
# Local: http://localhost:3000. Prod: https://filadd.com.
VITE_AUTH_CONTINUE_URL=http://localhost:3000
